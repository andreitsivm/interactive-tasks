# ─── Shared (must match apps/web AUTH_SECRET exactly) ────────
AUTH_SECRET=...

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Server ──────────────────────────────────────────────────
# Optional — defaults to 4000 if unset
PORT=4000

# ─── Redis ───────────────────────────────────────────────────
# Railway private URL (redis://redis.railway.internal:6379) inside Railway;
# use the TCP proxy URL for local dev
REDIS_URL=redis://default:pass@host:6379

# ─── Swagger (staging/dev only) ──────────────────────────────
# Username and password for the Basic Auth prompt at /api/docs
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeme
