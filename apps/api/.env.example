# ─── Shared (must match apps/web AUTH_SECRET exactly) ────────
AUTH_SECRET=...

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Server ──────────────────────────────────────────────────
# Optional — defaults to 4000 if unset
PORT=4000
