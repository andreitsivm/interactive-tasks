# ─── Shared (must match apps/api AUTH_SECRET exactly) ────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ─── Auth.js ─────────────────────────────────────────────────
AUTH_URL=http://localhost:3000

# ─── Google OAuth (optional — sign-in button hidden if absent) ───
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://default:pass@host:6379

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# Verified sender domain in Resend dashboard
MAIL_FROM=noreply@yourdomain.com

# ─── Paddle payments ─────────────────────────────────────────
# Server-side API key — never expose to the browser
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_STARTER=
PADDLE_PRICE_ID_PRO=
# Client-side token (safe to expose — read-only, no billing ops)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" or "production"
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ─── Site ────────────────────────────────────────────────────
# Public URL used in OG tags and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3000
